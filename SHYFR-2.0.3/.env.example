# SHYFR 2.0 serwer: wyłącznie wartości przykładowe. Prawdziwe sekrety ustaw w środowisku produkcyjnym, nigdy w repozytorium.
SHYFR_DB_PATH=./data/shyfr.db
SHYFR_HOST=127.0.0.1
SHYFR_PORT=8080
# Za reverse proxy: lista adresów (CIDR) proxy, którym wolno podawać adres klienta w X-Forwarded-For. Puste = nagłówek ignorowany.
# Stara zmienna SHYFR_TRUSTED_PROXY została usunięta (serwer nie wystartuje, jeśli jest ustawiona).
SHYFR_TRUSTED_PROXIES=
# Magazyn limitów żądań: memory (jedna instancja) lub sqlite (wiele procesów na jednym hoście).
SHYFR_RATE_LIMIT_BACKEND=memory
# Czas życia nieodebranej wiadomości w kolejce (sekundy). Domyślnie 30 dni.
SHYFR_MESSAGE_TTL=2592000
