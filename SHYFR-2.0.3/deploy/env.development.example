# SHYFR 2.0: środowisko development. Lokalnie, bez proxy. HTTP tylko do testów na tej samej maszynie/emulatorze.
# Skopiuj do /etc/shyfr/server.env (lub .env), uprawnienia 600. NIE zatwierdzaj wypełnionego pliku w repozytorium.
SHYFR_HOST=127.0.0.1
SHYFR_PORT=8080
SHYFR_DB_PATH=./data/shyfr-dev.db
# Adresy TCP reverse proxy (CIDR), którym wolno podawać adres klienta. Za Caddy/nginx na tej samej maszynie:
SHYFR_TRUSTED_PROXIES=
# memory = jedna instancja; sqlite = wiele procesów na jednym hoście. Wiele hostów wymaga własnej implementacji RateLimitStore (zob. docs).
SHYFR_RATE_LIMIT_BACKEND=memory
# Czas życia nieodebranych wiadomości w sekundach (domyślnie 30 dni)
SHYFR_MESSAGE_TTL=2592000
